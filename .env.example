# Para demonstração local: não é necessária chave de API.
AI_PROVIDER=demo

# Para API real: AI_PROVIDER=openai_compatible e uma chave válida.
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.2
AI_TIMEOUT=40
AI_JSON_MODE=true

# Opcional: sem configurar, será usado SQLite em instance/supportdesk.sqlite3.
# DATABASE_URL=sqlite:////caminho/absoluto/supportdesk.sqlite3
