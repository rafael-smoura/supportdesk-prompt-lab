# Configuração local inicial. O modo demo não chama uma IA real.
APP_ENV=development
AI_PROVIDER=demo
AI_MODEL=demo-local
AI_API_KEY=

# Usado apenas quando AI_PROVIDER=openai_compatible.
AI_API_URL=https://api.openai.com/v1/chat/completions

# Parâmetros aplicados ao provedor e registrados nos experimentos.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1300
AI_TIMEOUT=35
AI_JSON_MODE=true

# Configure um token forte se expuser a aplicação na internet.
# Em APP_ENV=production, APP_ACCESS_TOKEN é obrigatório.
APP_ACCESS_TOKEN=

# O padrão usa SQLite em instance/supportdesk.db.
# DATABASE_URL=sqlite:////caminho/absoluto/supportdesk.db
# EXPORT_DIR=/caminho/para/history

# Porta para execução local (5000 por padrão).
PORT=5000
